auto-install-peers=true
strict-peer-dependencies=false
prefer-workspace-packages=true
# Fetch all public Kolektiv packages from the aggregated group repository.
# (Publishing goes to the per-project hosted repo, e.g. brand-npm.)
@kolektiv:registry=https://repo.yuri.capital/repository/npm-public/
# Dual-publish target (CI): @kolektiv:registry=https://npm.pkg.github.com

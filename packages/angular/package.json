{
  "name": "@kolektiv/brand-angular",
  "version": "0.1.0",
  "description": "Angular standalone components for the Kolektiv brand mark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["kolektiv", "brand", "logo", "svg", "angular"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KolektivComputer/brand.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kolektiv/brand-core": "workspace:^"
  },
  "devDependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "happy-dom": "^20.0.0",
    "rxjs": "^7.8.0",
    "typescript": "~5.8.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^19 || ^20",
    "@angular/core": "^19 || ^20",
    "@angular/platform-browser": "^19 || ^20",
    "rxjs": "^7.4.0"
  }
}

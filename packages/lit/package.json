{
  "name": "@kolektiv/brand-lit",
  "version": "0.1.0",
  "description": "Lit components for the Kolektiv brand mark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "theme.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["kolektiv", "brand", "logo", "svg", "lit", "web-components"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KolektivComputer/brand.git",
    "directory": "packages/lit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kolektiv/brand-core": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0",
    "jsdom": "^30.0.1",
    "lit": "^3.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "lit": "^3"
  }
}

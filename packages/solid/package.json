{
  "name": "@kolektiv/brand-solid",
  "version": "0.1.0",
  "description": "SolidJS components for the Kolektiv brand mark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "theme.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["kolektiv", "brand", "logo", "svg", "solid"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KolektivComputer/brand.git",
    "directory": "packages/solid"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kolektiv/brand-core": "workspace:^"
  },
  "devDependencies": {
    "solid-js": "^1.9.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9"
  }
}

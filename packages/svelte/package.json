{
  "name": "@kolektiv/brand-svelte",
  "version": "0.1.0",
  "description": "Svelte components for the Kolektiv brand mark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./theme.css"],
  "files": [
    "dist",
    "theme.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "kolektiv",
    "brand",
    "logo",
    "svg",
    "svelte"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KolektivComputer/brand.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kolektiv/brand-core": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "svelte": "^5"
  }
}

{
  "name": "@kolektiv/brand-vue",
  "version": "0.1.1",
  "description": "Vue components for the Kolektiv brand mark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./theme.css"],
  "files": [
    "dist",
    "theme.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "kolektiv",
    "brand",
    "logo",
    "svg",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KolektivComputer/brand.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kolektiv/brand-core": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.42",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.4"
  }
}
